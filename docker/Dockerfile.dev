# syntax=docker/dockerfile:1.6
#
# FORTIS dev container (CPU / non-Isaac variant). Multi-arch base selection:
#   amd64 -> osrf/ros:humble-desktop  (FORTIS PC / WSL)
#   arm64 -> ros:humble-ros-base      (Jetson)
#
# Why arm64 uses a plain Humble base and not the GPU/Isaac image: NVIDIA's arm64
# Isaac ROS base (Dockerfile.dev-gpu) is now Ubuntu 24.04 (Noble) / Isaac ROS
# 4.x, which has NO ros-humble-* packages -- incompatible with the FORTIS Humble
# stack. Until FORTIS moves to Jazzy (or a Humble-era Isaac image is re-pinned),
# the Jetson runs the Humble nodes (incl. the OAK camera) on this Humble/Jammy
# base via the cpu profile. CUDA/Isaac perception is a separate track.
#
# TARGETARCH is passed by ./stack -- docker compose build does not auto-populate
# the predefined buildarg the way `docker buildx build` does.
ARG BASE_IMAGE_AMD64=osrf/ros:humble-desktop
ARG BASE_IMAGE_ARM64=ros:humble-ros-base
FROM ${BASE_IMAGE_AMD64} AS base-amd64
FROM ${BASE_IMAGE_ARM64} AS base-arm64
ARG TARGETARCH
FROM base-${TARGETARCH} AS fortis-dev

ARG USERNAME=FORTIS
ARG USER_UID=1000
ARG USER_GID=1000

# Install necessary packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    git \
    curl \
    wget \
    nano \
    build-essential \
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    ros-humble-xacro \
    ros-humble-joint-state-publisher-gui \
    ros-humble-robot-localization \
    ros-humble-moveit \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    ros-humble-controller-manager \
    ros-humble-tf2-tools \
    ros-humble-rqt-tf-tree \
    ros-humble-foxglove-bridge \
    can-utils \
    iproute2 \
    kmod \
    python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# depthai-ros v3 (RVC2 + RVC4 OAK camera driver). v3 lives in the ROS 2
# *testing* apt repo, enabled by the ros2-testing-apt-source package. The v3
# core lib (ros-humble-depthai-v3) conflicts on files with the v2
# ros-humble-depthai, so this image installs ONLY v3 -- the v2
# ros-humble-depthai-ros line was deliberately removed from the list above.
# Package/launch are suffixed _v3 on Humble (depthai_ros_driver_v3 /
# driver.launch.py); see src/fortis_bringup/launch/oak_chassis_front.launch.py.
RUN apt-get update && apt-get install -y --no-install-recommends ros2-testing-apt-source \
 && apt-get update && apt-get install -y \
      ros-humble-depthai-ros-v3 \
      ros-humble-diagnostic-updater \
 && rm -rf /var/lib/apt/lists/*
# NOTE: no --no-install-recommends on the depthai line. The arm64 base
# (ros:humble-ros-base) is minimal -- unlike osrf desktop it omits packages the
# driver dlopens (e.g. libdiagnostic_updater.so), and those come in as Recommends.
# diagnostic_updater is also listed explicitly as a belt-and-suspenders guard.

RUN pip install --no-cache-dir \
    depthai \
    python-can \
    pyserial \
    odrive \
    numpy \
    matplotlib \
    scipy

RUN groupadd --gid ${USER_GID} ${USERNAME} \
 && useradd -m -s /bin/bash --uid ${USER_UID} --gid ${USER_GID} ${USERNAME} \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/${USERNAME} \
    && chmod 440 /etc/sudoers.d/${USERNAME}

RUN echo "source /opt/ros/humble/setup.bash" >> /home/${USERNAME}/.bashrc \
 && echo "if [ -f /workspace/install/setup.bash ]; then source /workspace/install/setup.bash; fi" >> /home/${USERNAME}/.bashrc \
 && echo "alias ll='ls -la'" >> /home/${USERNAME}/.bashrc

USER ${USERNAME}
WORKDIR /workspace

CMD ["/bin/bash"]
