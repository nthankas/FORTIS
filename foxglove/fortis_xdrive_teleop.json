{
  "configById": {
    "Teleop!translate": {
      "topic": "/cmd_vel",
      "publishRate": 10,
      "upButton": { "field": "linear-x", "value": 0.2 },
      "downButton": { "field": "linear-x", "value": -0.2 },
      "leftButton": { "field": "linear-y", "value": 0.2 },
      "rightButton": { "field": "linear-y", "value": -0.2 }
    },
    "Teleop!rotate": {
      "topic": "/cmd_vel",
      "publishRate": 10,
      "upButton": { "field": "linear-x", "value": 0 },
      "downButton": { "field": "linear-x", "value": 0 },
      "leftButton": { "field": "angular-z", "value": 0.4 },
      "rightButton": { "field": "angular-z", "value": -0.4 }
    },
    "Teleop!orbit": {
      "topic": "/fortis/commands/orbit_dir",
      "publishRate": 10,
      "upButton": { "field": "angular-z", "value": 0 },
      "downButton": { "field": "angular-z", "value": 0 },
      "leftButton": { "field": "angular-z", "value": 1 },
      "rightButton": { "field": "angular-z", "value": -1 }
    },
    "Publish!arm": {
      "buttonText": "ENABLE DRIVE",
      "buttonTooltip": "Publishes std_msgs/Bool true on /fortis/commands/drive_enable. drive_enable_node activates wheel_velocity_controller (ODrives -> CLOSED_LOOP_CONTROL).",
      "buttonColor": "#68e24a",
      "advancedView": true,
      "topicName": "/fortis/commands/drive_enable",
      "datatype": "std_msgs/msg/Bool",
      "value": "{ \"data\": true }"
    },
    "Publish!disarm": {
      "buttonText": "DISABLE DRIVE",
      "buttonTooltip": "Publishes std_msgs/Bool false on /fortis/commands/drive_enable. drive_enable_node deactivates wheel_velocity_controller (motors idle).",
      "buttonColor": "#e2a44a",
      "advancedView": true,
      "topicName": "/fortis/commands/drive_enable",
      "datatype": "std_msgs/msg/Bool",
      "value": "{ \"data\": false }"
    },
    "Publish!startorbit": {
      "buttonText": "START ORBIT (open gate)",
      "buttonTooltip": "Publishes std_msgs/Empty on /fortis/events/start_orbit to move the mission FSM IDLE -> ORBIT so /cmd_vel is accepted.",
      "buttonColor": "#4a9ce2",
      "advancedView": true,
      "topicName": "/fortis/events/start_orbit",
      "datatype": "std_msgs/msg/Empty",
      "value": "{}"
    },
    "Publish!stop": {
      "buttonText": "STOP (close gate)",
      "buttonTooltip": "Publishes std_msgs/Empty on /fortis/events/stop to move ORBIT -> IDLE; drive_node then rejects /cmd_vel and commands zeros.",
      "buttonColor": "#f54242",
      "advancedView": true,
      "topicName": "/fortis/events/stop",
      "datatype": "std_msgs/msg/Empty",
      "value": "{}"
    },
    "Publish!selectobserve": {
      "buttonText": "SELECT OBSERVE",
      "buttonTooltip": "Publishes std_msgs/Empty on /fortis/events/select_observe to route the mission FSM into the OBSERVE flow.",
      "buttonColor": "#4a9ce2",
      "advancedView": true,
      "topicName": "/fortis/events/select_observe",
      "datatype": "std_msgs/msg/Empty",
      "value": "{}"
    },
    "Publish!selectpick": {
      "buttonText": "SELECT PICK",
      "buttonTooltip": "Publishes std_msgs/Empty on /fortis/events/select_pick to route the mission FSM into the PICK flow.",
      "buttonColor": "#9c4ae2",
      "advancedView": true,
      "topicName": "/fortis/events/select_pick",
      "datatype": "std_msgs/msg/Empty",
      "value": "{}"
    },
    "Publish!done": {
      "buttonText": "DONE",
      "buttonTooltip": "Publishes std_msgs/Empty on /fortis/events/done to advance the mission FSM past the current step.",
      "buttonColor": "#68e24a",
      "advancedView": true,
      "topicName": "/fortis/events/done",
      "datatype": "std_msgs/msg/Empty",
      "value": "{}"
    },
    "Publish!cancel": {
      "buttonText": "CANCEL",
      "buttonTooltip": "Publishes std_msgs/Empty on /fortis/events/cancel to abort the current mission FSM flow.",
      "buttonColor": "#e2a44a",
      "advancedView": true,
      "topicName": "/fortis/events/cancel",
      "datatype": "std_msgs/msg/Empty",
      "value": "{}"
    },
    "Publish!reset": {
      "buttonText": "RESET",
      "buttonTooltip": "Publishes std_msgs/Empty on /fortis/events/reset to return the mission FSM to IDLE.",
      "buttonColor": "#f54242",
      "advancedView": true,
      "topicName": "/fortis/events/reset",
      "datatype": "std_msgs/msg/Empty",
      "value": "{}"
    },
    "Plot!wheels": {
      "paths": [
        { "value": "/fortis/drive/wheel_velocities.fl", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/fortis/drive/wheel_velocities.fr", "enabled": true, "timestampMethod": "receiveTime" },
        { "value": "/fortis/drive/wheel_velocities.rl", "enabled": true, "timestampMethod": "receiveTime" },
