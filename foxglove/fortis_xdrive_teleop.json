{
  "configById": {
    "Teleop!translate": {
      "topic": "/cmd_vel",
      "publishRate": 10,
      "upButton": { "field": "linear-x", "value": 0.2 },
      "downButton": { "field": "linear-x", "value": -0.2 },
      "leftButton": { "field": "linear-y", "value": 0.2 },
      "rightButton": { "field": "linear-y", "value": -0.2 }
    },
    "Teleop!rotate": {
      "topic": "/cmd_vel",
      "publishRate": 10,
      "upButton": { "field": "linear-x", "value": 0 },
