<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fortis_bringup</name>
  <version>0.0.0</version>
  <description>Top-level launch composition for FORTIS. Stub launch files only; node includes added per package as they come online.</description>
  <maintainer email="nikhilthankasala@gmail.com">Nikhil Thankasala</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>fortis_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <!-- depthai-ros v3 (depthai_ros_driver_v3 / depthai_descriptions_v3) is
       deliberately NOT declared as a rosdep key: it ships only in the ROS 2
       testing apt repo and is not in the public rosdep index, so declaring it
       would break `rosdep install` (CI and elsewhere). It is installed via the
       Dockerfiles (docker/Dockerfile.dev[-gpu]) instead. -->


  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
