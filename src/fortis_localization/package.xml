<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fortis_localization</name>
  <version>0.0.0</version>
  <description>Wheel odometry + robot_localization EKF (wheel odom + IMU) for the FORTIS X-drive base.</description>
  <maintainer email="nikhilthankasala@gmail.com">FORTIS</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>fortis_comms</depend>

  <exec_depend>robot_localization</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
