# =============================================================================
# FORTIS machine configuration — THE single per-machine config file.
#
#   cp fortis.env.example .env      # then edit for THIS machine
#
# Every address, port, device node, and mode that varies between machines
# lives here and nowhere else. The real `.env` is gitignored, so each
# machine (operator station, Jetson, teammate laptop) carries its own.
#
# Who reads it:
#   ./stack               sources it, then exports every value
#   docker compose        substitutes ${VAR} in docker/docker-compose*.yml
#   the dev container     receives the FORTIS_* / ROS_* values as env vars
#   ROS launch files      read the FORTIS_* values as launch-arg defaults
#
# Precedence (last wins):
#   built-in default  <  this file  <  explicit launch arg on the CLI
# So `ros2 launch ... can_interface:=can0` still overrides FORTIS_CAN_IF
# for that one run, without editing anything.
#
# NOT here: tuned robot behaviour (PID gains, orbit speed, IMU debias
# rates). Those are identical on every machine and belong in version
# control — see src/fortis_bringup/config/bringup_params.yaml.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. WHAT THIS MACHINE RUNS
# -----------------------------------------------------------------------------

# Git ref this machine tracks. `./stack pull` checks it out; `./stack up`
# warns if HEAD is something else. Branch name for dev machines, a release
# tag for the robot / demo machines.
FORTIS_REF=main

# Which container variant to build and run.
#   cpu -> docker/docker-compose.yml only      (service dev,  container fortis-dev)
#   gpu -> + docker/docker-compose.gpu.yml     (service/container fortis-dev-gpu)
# Use cpu on any machine without an NVIDIA GPU. Use gpu on the Jetson Orin
# Nano and on GPU workstations (requires the NVIDIA Container Toolkit).
COMPOSE_PROFILE=cpu

# docker compose project name — prefixes container / network / volume names.
# Leave alone unless running two FORTIS stacks side by side on one host.
COMPOSE_PROJECT_NAME=fortis


# -----------------------------------------------------------------------------
# 2. NETWORK / ADDRESSES
#
# FORTIS needs exactly two inbound TCP ports on the robot: 22 (ssh) and the
# Foxglove bridge port below. Nothing else on the robot has a network
# identity — DDS is loopback-only, cameras are USB, drives are CAN, the arm
# is USB serial. See docs/HANDOFF.md section 8.
# -----------------------------------------------------------------------------

# How THIS machine reaches the robot. The only host/address string the
# codebase reads; consumed by `./stack ssh`. Accepts anything ssh accepts.
# Leave BLANK on the Jetson itself — `./stack ssh` then correctly no-ops.
#
#   FORTIS_JETSON_HOST=fortis@192.168.10.2       # direct wired link (deployed)
#   FORTIS_JETSON_HOST=fortis@fortis-jetson.ga   # corporate DNS
#   FORTIS_JETSON_HOST=fortis-jetson             # ~/.ssh/config alias (best:
#                                                #   encodes ProxyJump, port,
#                                                #   identity file outside git)
FORTIS_JETSON_HOST=

# foxglove_bridge WebSocket port — the operator interface. Foxglove Studio
# connects to ws://<this machine>:<port>. Change only if 8765 is taken.
FORTIS_FOXGLOVE_PORT=8765

# ROS 2 DDS domain id. Every FORTIS machine on one physical network must
# agree. Project convention is 42; do not change casually.
ROS_DOMAIN_ID=42

# Keep DDS on loopback (1) or let it use host interfaces (0).
# KEEP THIS 1. All FORTIS nodes are co-located in one container under host
# networking; exposing VPN / docker0 / wifi interfaces to DDS breaks
# multicast discovery between the very nodes that must talk to each other.
# Only the Foxglove WebSocket is meant to cross machines.
ROS_LOCALHOST_ONLY=1


# -----------------------------------------------------------------------------
# 3. HARDWARE INTERFACES
#
# Device nodes and buses, which differ between the Jetson, a bench host, and
# a hardware-free laptop.
# -----------------------------------------------------------------------------

# SocketCAN interface for the ODrive drive bus. Brought up automatically by
# docker/can-up.sh at container start (tolerant: a missing adapter logs a
# note and does not block).
#   can1   the gs_usb USB-CAN adapter on the Jetson  (the committed path)
#   can0   onboard Tegra mttcan — NOT wired to the ODrive chain
#   vcan0  virtual CAN, for the hardware-free dry run in docs/HANDOFF.md 6.6e
FORTIS_CAN_IF=can1

# CAN bitrate. MUST match what is configured on the ODrives (FORTIS uses
# 250000). A mismatch shows up as zero frames on candump, not as an error.
FORTIS_CAN_BITRATE=250000

# Teensy 4.1 arm-controller USB-CDC port (used with arm:=true).
# For hardware-free runs, set this to the pty that tools/mock_teensy.py
# prints on startup, e.g. /dev/pts/3.
FORTIS_TEENSY_PORT=/dev/ttyACM0


# -----------------------------------------------------------------------------
# 4. CREDENTIALS
# -----------------------------------------------------------------------------

# NGC API key, only needed to pull the Isaac ROS base image from nvcr.io for
# the gpu profile. Leave blank and run `docker login nvcr.io` by hand
# instead. NEVER commit a real key — .env is gitignored, this template is not.
NGC_API_KEY=
